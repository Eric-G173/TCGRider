{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "framer-motion": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "react-scripts": "^5.0.1",
    "web-vitals": "^6.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.2",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "underscore": "1.13.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "server": "dotnet watch --project ../backend run",
    "dev": "concurrently -n REACT,ELECTRON,DOTNET -c blue,magenta,green \"npm start\" \"wait-on http://localhost:3000 && electron .\" \"npm run server\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
